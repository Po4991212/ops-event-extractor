# Copy to .env and fill in. Never commit .env. Prefer an OS credential store
# for real secrets; this file is a fallback for local development only, and
# it must stay owner-readable and gitignored (it already is — see .gitignore).

# ---- Mode -------------------------------------------------------------
# synthetic (default) = only data/synthetic/*.json is ever read; no network
# calls to Gmail, QQ, or Anthropic are made regardless of other flags below.
# live = process the real mailbox. Requires GMAIL_* below and --live on the
# CLI. Fails closed: OPS_MODE unset or anything other than "live" is treated
# as synthetic.
OPS_MODE=synthetic

# ---- Gmail --------------------------------------------------------------
# Scopes: start with gmail.readonly only (see docs/adr/0003-gmail-scopes.md).
# OAuth desktop-app client. Store the refresh token OUTSIDE the repo — an OS
# credential store, or a file outside this directory with owner-only perms.
# Do not paste a real client secret or refresh token into this file.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_TOKEN_STORE_PATH=/path/outside/repo/gmail.token.json
GMAIL_MAILBOX=commercialtx@aiinsure.com
GMAIL_SYNC_SINCE=2026/06/01

# ---- Anthropic ------------------------------------------------------------
# Live extraction is disabled (see OPS_LLM_LIVE_APPROVED below) until the
# agency has confirmed the API account and retention arrangement in
# docs/adr/0004-anthropic-data-flow.md. Model IDs are verified in
# docs/research-sources.md; do not use undocumented aliases.
ANTHROPIC_API_KEY=
ANTHROPIC_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5
# Set to "true" only after the agency-approved Anthropic account and
# retention arrangement are documented and confirmed. Defaults closed.
OPS_LLM_LIVE_APPROVED=false

# ---- QQ Catalyst: read the real client index (§4.4, ADR 0007) -----------
# "Enterprise API Access" credentials from Vertafore. Verified request
# shape: Authorization: Basic base64(clientid:clientsecret), ISO-8859-1
# encoded — src/resolve/qqClient.js builds this for you; just set the two
# values below. Never paste the actual client id/secret anywhere but here.
QQ_API_BASE_URL=https://api.qqcatalyst.com/v1
QQ_API_CLIENT_ID=
QQ_API_CLIENT_SECRET=
# Where `cli.js refresh-client-index` writes the real client list. MUST
# stay outside src/ (enforced in code, not just this comment — see ADR
# 0006/0007) since src/resolve/index.json is the committed, public,
# synthetic-only demo index. data/private/ is gitignored.
QQ_CLIENT_INDEX_PATH=data/private/client-index.json
# Only used by --from-csv as an alternative to the API (see README "Real QQ
# client index"); column names are configurable because this repo has no
# confirmed CSV export schema for your agency's QQ instance.
QQ_EXPORT_PATH=
QQ_EXPORT_FORMAT=csv
QQ_EXPORT_COL_ID=client_id
QQ_EXPORT_COL_NAME=client_name
QQ_EXPORT_COL_ZIP=zip
QQ_EXPORT_COL_POLICIES=policy_numbers
QQ_EXPORT_POLICY_DELIMITER=;

# ---- QQ Catalyst write-back (separate from the read-only client above) --
# No verified endpoint/contract for *creating* a note in QQ was found
# (see docs/adr/0001-no-existing-toolkit-found.md). src/writeback/qq.js
# runs in dry-run only until this is filled in with a verified contract.
QQ_API_TOKEN=
QQ_LIVE_WRITES_APPROVED=false

# ---- Review queue -------------------------------------------------------
REVIEW_SERVER_PORT=8766

# ---- Confidence routing thresholds (tuned in Phase 5, see docs/SPEC.md §5.4)
OPS_CONFIDENCE_AUTO=0.85
OPS_CONFIDENCE_REVIEW=0.55
