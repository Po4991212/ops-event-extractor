# Ops Event Extractor - environment template
# Copy to .env for LOCAL SYNTHETIC use. Real values belong in the OS credential store.

# ---- Data mode -------------------------------------------------------------
# synthetic (default) | live   Live mailbox access fails closed without this.
OPS_DATA_MODE=synthetic

# ---- External write approval ----------------------------------------------
# Switch 2 of 2. Switch 1 is the --live flag on the command itself.
# Neither switch permits sending email or changing coverage.
OPS_EXTERNAL_WRITES_APPROVED=0

# ---- Model runtime ---------------------------------------------------------
# stub (offline deterministic) | astra (OpenAI Responses API, gpt-6-astra)
OPS_MODEL_MODE=stub
OPS_MODEL_NAME=gpt-6-astra
OPS_MODEL_SNAPSHOT=
OPS_REASONING_EFFORT_CLASSIFY=low
OPS_REASONING_EFFORT_EXTRACT=medium
# API key is read from the OS credential store, NOT from this file.
# The variable below exists only so a developer can point at a local proxy.
OPS_OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Agency ----------------------------------------------------------------
OPS_TIMEZONE=America/Chicago
OPS_DB_PATH=var/ops.sqlite
OPS_RAW_STORE=var/raw
OPS_REVIEW_PORT=8766
